				}</style><style id="wp-custom-css">h2 {
    word-spacing: 5px;
}

.elementor-field-group .elementor-field-textual.elementor-field-tel-prefix {
    max-width: 100px !important;
    background-color: #fff !important;
}

span.elementor-field-option {
    font-size: 14px;
}

.left-panel .elementor-element-3a1ac69 h3{
	    background: linear-gradient(to right, #239acf 0%,#265ca9 100%);
	    overflow: hidden;
    clear: both;
    margin-bottom: 15px;
    padding: 70px 15px 10px;
}

.left-panel .elementor-widget-image-box .elementor-image-box-wrapper{
	border: 1px solid #c4c4c4;
	    padding: 25px 25px;
}
.elementor-1404 .elementor-element.elementor-element-f29da81{
	    border-top: 1px solid #cdcdcd!important;
    padding-top: 15px!important;
}
.six-box .box1{
	background: #4467b3;
}
.six-box .box2{
	background: #40b3db;
}
.six-box .box3{
	background: #4a6705;
}
.six-box .box4{
	background: #867b72;
}
.six-box .box5{
	background: #f88553;
}
.six-box .box6{
	background: #c675d8;
}
.six-box .box img{
	    padding: 50px 0px 35px;
}
.six-box .box h3{
	    display: block;
    overflow: hidden;
       padding: 9px 7px;
       background: rgb(66 92 158 / 92%);
    color: #fff;
    font-size: 16px;
    margin: 0;
}

.faq-col .table > tbody > tr > td > span {
    color: #0066CC;
}
.faq-col .elementor-accordion-title{
	    font-size: 18px;
    color: #266ab1;
}
.faq-col .fas{
	    font-size: 16px;
}
.faq-col .elementor-accordion .elementor-tab-title .elementor-accordion-icon{
	    width: 21px;
}
.faq-col .elementor-accordion .elementor-tab-title {
    color: #000000 !important;
    background-color: #e8e8e8 !important;
    border-color: #e8e8e8 !important;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
.faq-co .pdf-area > ul {
    margin-bottom: 15px;
    list-style-type: none;
    padding-left: 0;
}
.faq-col .pdf-area > ul li {
    padding: 10px;
    background: #f4f4f4;
}
.faq-col .pdf-area > ul li:nth-child(even) {
    background: #fff;
}
.faq-col .pdf-area > ul li a{
	    padding-left: 10px;
	    color: #4467b3;
}
.faq-col .elementor-accordion .elementor-accordion-item {
    margin-bottom: 13px;
}
.faq-col .table > tbody > tr > td strong {
    color: #0066CC!important;
    font-weight: 300;
    font-size: 14px;
}

.tab-panel-right .elementor-widget-tabs.elementor-tabs-view-horizontal .elementor-tab-desktop-title.elementor-active{
	    border-bottom-style: inset;
}
.tab-panel-right p > strong {
    color: #2571b6;
    font-size: 16px;
}

.admision-status p a strong{
	    color: #265fab;
}

/*******sagnik****/
.logo-school h5{
	font-size: 20px;
	font-weight: 600;
	    padding-bottom: 0px;
    line-height: 10px;
}

.elementor-post__text{
	    background: #faf4ed;
    padding: 15px;
    margin-top: -50px;
    z-index: 1;
    border-radius: 5px;
    width: 90% !important;
}
.type-post{margin-top:70px; margin-bottom:70px;}

.type-post .post-featured-image img{border-radius:7px;}

.type-post .entry-title{
	    font-family: 'LORA BOLD';
    text-transform: capitalize;
}
.type-post .post-meta{padding-bottom:20px;}
.elementor-widget-testimonial-carousel .swiper-slide {
    padding: 5px !important;
}
.table-striped th{
       background-color: #26479d;
    color: #fff;
    font-family: Lora;
}
.table-striped td{
    font-family: 'Inter Regular';
}

.certificate-download-container {
    text-align: center;
    margin: 100px auto;
}

.certificate-download-container h2 {
    font-size: 28px;
    margin-bottom: 20px;
    color: #333;
    font-family: 'Georgia', serif;
}

.download-button {
    display: inline-block;
    padding: 12px 24px;
    background-color: #2C54A6; /* Adjust the colour as per your design */
    color: #fff;
    font-size: 16px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.3s ease;
}

.download-button:hover {
